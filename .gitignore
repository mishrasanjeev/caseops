.DS_Store
.env
.env.*
!.env.example
!.env.local.example
# MCP server configs are per-developer/per-machine and may carry
# client credentials. Keep local; never commit. Use `.mcp.json.example`
# if a template is needed.
.mcp.json
.idea/
.vscode/
# Ignore Claude Code's local state but keep vendored skills in .claude/skills/.
.claude/projects/
.claude/todos/
.claude/statsig/
.claude/shell-snapshots/
.claude/sessions/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
# Codex/plugin local config can contain connector headers or client secrets.
.codex/
# Extracted CI/browser traces frequently contain session cookies/JWTs.
.ci-artifact-debug/
.tmp/
.tmp-sweep/
tmp/
tmp-*.html
# Local document-storage root — grows at runtime with tenant uploads
# and export artifacts. GCS bucket path in prod; never in git.
apps/api/storage/
*.log
*.pid
*.seed
*.out
*.err
*.stackdump
coverage/
dist/
build/
*.db
