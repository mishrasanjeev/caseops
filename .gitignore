.pytest_cache/
# pytest --basetemp output — a test run leaves 30+ synthetic
# document fixtures here. Codex used this path on the 2026-04-19
# audit; IDEs were flagging the 37 files as uncommitted changes.
.pytest-tmp/
apps/api/.pytest-tmp/
*.tmp-pytest*/
.tmp-audit-pytest/
.tmp-pytest*/
pytest-basetemp*/
pytest-cache-files*/
apps/api/.tmp-pytest*/
apps/api/.tmp-review*/
apps/api/pytest-cache-files*/
pytest-basetemp-coverage/
# Coverage JSON artifact written by `coverage json` during the gate
# run; the per-CI artifact upload is the durable copy.
apps/api/coverage.json
