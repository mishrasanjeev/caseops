{
  "schema_version": 1,
  "production_project": "perfect-period-305406",
  "location": "asia-south1",
  "invoker_service_account": "caseops-scheduler-invoker@perfect-period-305406.iam.gserviceaccount.com",
  "jobs": [
    {
      "scheduler_name": "caseops-legal-update-sync-midnight",
      "run_job_name": "caseops-legal-update-sync",
      "schedule": "0 0 * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "ENABLED",
      "task_timeout_seconds": null,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution"
    },
    {
      "scheduler_name": "caseops-case-tracking-poll-1630-ist",
      "run_job_name": "caseops-case-tracking-poll",
      "schedule": "30 16 * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "ENABLED",
      "task_timeout_seconds": null,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution"
    },
    {
      "scheduler_name": "caseops-activity-report-0800-ist",
      "run_job_name": "caseops-activity-report",
      "schedule": "0 8 * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "ENABLED",
      "task_timeout_seconds": null,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution"
    },
    {
      "scheduler_name": "caseops-reminders-cadence",
      "run_job_name": "caseops-reminders-job",
      "schedule": "*/5 * * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "ENABLED",
      "task_timeout_seconds": null,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution"
    },
    {
      "scheduler_name": "caseops-extract-authority-metadata-daily",
      "run_job_name": "caseops-extract-authority-metadata",
      "schedule": "30 0 * * *",
      "time_zone": "UTC",
      "desired_state": "PAUSED",
      "task_timeout_seconds": 43200,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution"
    },
    {
      "scheduler_name": "caseops-db-index-health-weekly",
      "run_job_name": "caseops-db-index-health",
      "schedule": "30 2 * * 0",
      "time_zone": "UTC",
      "desired_state": "ENABLED",
      "task_timeout_seconds": null,
      "image_policy": "release_digest",
      "canary_policy": "manual_safe"
    },
    {
      "scheduler_name": "caseops-ip-journal-watch-publication-cadence",
      "run_job_name": "caseops-ip-journal-watch",
      "schedule": "15 */2 * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "ENABLED",
      "task_timeout_seconds": 900,
      "image_policy": "release_digest",
      "canary_policy": "scheduled_execution",
      "bootstrap": {
        "command": ["uv"],
        "args": ["run", "caseops-ip-journal-watch"],
        "environment": {
          "CASEOPS_ENV": "cloud",
          "CASEOPS_AUTO_MIGRATE": "false"
        },
        "secrets": {
          "CASEOPS_DATABASE_URL": "caseops-database-url:latest",
          "CASEOPS_AUTH_SECRET": "caseops-auth-secret:latest"
        },
        "service_account": "caseops-runtime@perfect-period-305406.iam.gserviceaccount.com",
        "cloud_sql_instances": "perfect-period-305406:asia-south1:caseops-db",
        "cpu": "1",
        "memory": "1Gi",
        "max_retries": 1
      }
    },
    {
      "scheduler_name": "caseops-judge-mapping-refresh-daily",
      "run_job_name": "caseops-judge-mapping-refresh",
      "schedule": "15 1 * * *",
      "time_zone": "Asia/Kolkata",
      "desired_state": "PAUSED",
      "task_timeout_seconds": 3600,
      "image_policy": "release_digest",
      "canary_policy": "manual_safe",
      "bootstrap": {
        "command": ["uv"],
        "args": ["run", "caseops-refresh-bench-analysis-layers"],
        "environment": {
          "CASEOPS_ENV": "cloud",
          "CASEOPS_AUTO_MIGRATE": "false"
        },
        "secrets": {
          "CASEOPS_DATABASE_URL": "caseops-database-url:latest",
          "CASEOPS_AUTH_SECRET": "caseops-auth-secret:latest"
        },
        "service_account": "caseops-runtime@perfect-period-305406.iam.gserviceaccount.com",
        "cloud_sql_instances": "perfect-period-305406:asia-south1:caseops-db",
        "cpu": "1",
        "memory": "1Gi",
        "max_retries": 1
      }
    }
  ],
  "legacy_schedulers_to_pause": ["caseops-case-tracking-poll-midnight"]
}
