CASEOPS_ENV=local
CASEOPS_API_NAME=CaseOps API
CASEOPS_API_VERSION=0.1.0
CASEOPS_API_HOST=0.0.0.0
CASEOPS_API_PORT=8000
CASEOPS_API_DOCS_ENABLED=true
CASEOPS_PUBLIC_APP_URL=http://localhost:3000
CASEOPS_DATABASE_URL=postgresql+psycopg://caseops:caseops@127.0.0.1:5432/caseops
# Local CaseOps runtime should use Postgres 17 + pgvector to match production.
CASEOPS_AUTH_SECRET=change-me-change-me-change-me-2026
# Required: set to a 32+ byte secret in staging/production. The default above
# is rejected at startup whenever CASEOPS_ENV is staging/production/prod.
CASEOPS_ACCESS_TOKEN_TTL_MINUTES=120
CASEOPS_MFA_EXISTING_USER_GRACE_DAYS=7
CASEOPS_MFA_STEP_UP_TTL_MINUTES=15
CASEOPS_MFA_MAX_FAILURES_PER_5M=5
CASEOPS_AUTO_MIGRATE=true
CASEOPS_DOCUMENT_STORAGE_BACKEND=local
CASEOPS_DOCUMENT_STORAGE_PATH=./storage/documents
CASEOPS_DOCUMENT_STORAGE_CACHE_PATH=./storage/document-cache
CASEOPS_DOCUMENT_STORAGE_GCS_BUCKET=
CASEOPS_DOCUMENT_STORAGE_GCS_PREFIX=documents
CASEOPS_GCP_PROJECT_ID=
CASEOPS_TESSERACT_COMMAND=
CASEOPS_DOCUMENT_WORKER_POLL_INTERVAL_SECONDS=10
CASEOPS_DOCUMENT_WORKER_BATCH_SIZE=5
CASEOPS_DOCUMENT_PROCESSING_STALE_AFTER_MINUTES=15
CASEOPS_DOCUMENT_RETRY_AFTER_HOURS=6
CASEOPS_DOCUMENT_REINDEX_AFTER_HOURS=168
CASEOPS_DOCUMENT_REPROCESSING_BATCH_SIZE=10
CASEOPS_CASE_TRACKING_DAILY_WINDOW_START=16:00
CASEOPS_CASE_TRACKING_DAILY_WINDOW_END=18:00
CASEOPS_CASE_TRACKING_DAILY_TIMEZONE=Asia/Kolkata
CASEOPS_COMPLIANCE_AI_EXTRACTION_ENABLED=false
CASEOPS_COMPLIANCE_AI_EXTRACTION_AUTO_RUN_ENABLED=false
CASEOPS_COMPLIANCE_AUTO_ACTIVATE_GENERATED_WORK_ENABLED=false
CASEOPS_MATTER_BILLING_CONFIG_ENABLED=true
CASEOPS_CAUSE_LIST_EXPORT_ENABLED=true
CASEOPS_BILLING_COMPANY_GSTIN=09AANCM5923C1ZD
CASEOPS_BILLING_MINIMUM_GROSS_MARGIN_BPS=7000

# IP product rollout safety. These flags are evaluated independently from the
# authenticated user's server-side capability and the tenant's billing-plan
# entitlement. All default off. Set an optional ISO-8601 expiry for a bounded
# pilot; an elapsed expiry fails closed. Provider/readiness gates remain
# additional requirements for the later automated workflows.
CASEOPS_IP_WORKSPACE_ENABLED=false
CASEOPS_IP_WORKSPACE_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_REGISTRY_SYNC_ENABLED=false
CASEOPS_IP_REGISTRY_SYNC_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_DEADLINE_AUTOMATION_ENABLED=false
CASEOPS_IP_DEADLINE_AUTOMATION_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_NOTIFICATION_AUTOMATION_ENABLED=false
CASEOPS_IP_NOTIFICATION_AUTOMATION_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_FILING_OPERATIONS_ENABLED=false
CASEOPS_IP_FILING_OPERATIONS_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_WATCH_ENABLED=false
CASEOPS_IP_WATCH_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_COSTS_ENABLED=false
CASEOPS_IP_COSTS_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_RULE_GOVERNANCE_ENABLED=false
CASEOPS_IP_RULE_GOVERNANCE_ROLLOUT_EXPIRES_AT=
# IPLF-027 shared reliability consumers and versioned IP workflow commands are
# separate dark-launch surfaces. Keep both off until their own rollout review.
CASEOPS_DOMAIN_OUTBOX_CONSUMERS_ENABLED=false
CASEOPS_DOMAIN_OUTBOX_CONSUMERS_ROLLOUT_EXPIRES_AT=
CASEOPS_IP_WORKFLOW_COMMANDS_ENABLED=false
CASEOPS_IP_WORKFLOW_COMMANDS_ROLLOUT_EXPIRES_AT=

# Google Workspace connectors. Keep empty unless the Google OAuth app,
# redirect URIs, scopes, and tenant approval are ready. The app must remain
# metadata/review-first; do not enable uncontrolled mailbox or Drive ingestion.
CASEOPS_GOOGLE_CALENDAR_CLIENT_ID=
CASEOPS_GOOGLE_CALENDAR_CLIENT_SECRET=
CASEOPS_GOOGLE_CALENDAR_REDIRECT_URI=
CASEOPS_GOOGLE_CALENDAR_WEBHOOK_TOKEN=
CASEOPS_GMAIL_CLIENT_ID=
CASEOPS_GMAIL_CLIENT_SECRET=
CASEOPS_GMAIL_REDIRECT_URI=
CASEOPS_GMAIL_PUBSUB_TOPIC=
CASEOPS_GMAIL_WEBHOOK_VERIFICATION_TOKEN=
CASEOPS_GOOGLE_DRIVE_CLIENT_ID=
CASEOPS_GOOGLE_DRIVE_CLIENT_SECRET=
CASEOPS_GOOGLE_DRIVE_REDIRECT_URI=

# Microsoft 365 / Graph connector setup is stored per tenant through
# /app/admin/microsoft365. Store Graph client secrets only through the admin
# setup flow or approved secret storage; API responses never echo secret values.

# External notification providers. External email/SMS/WhatsApp delivery remains
# disabled unless provider config is valid and tenant/user preferences allow it.
CASEOPS_SENDGRID_API_KEY=
CASEOPS_SENDGRID_SENDER_EMAIL=
CASEOPS_SENDGRID_SENDER_NAME=CaseOps
CASEOPS_SENDGRID_WEBHOOK_PUBLIC_KEY=
CASEOPS_TWILIO_ENABLED=false
CASEOPS_TWILIO_ACCOUNT_SID=
CASEOPS_TWILIO_AUTH_TOKEN=
CASEOPS_TWILIO_FROM_NUMBER=
CASEOPS_WHATSAPP_ENABLED=false
CASEOPS_WHATSAPP_ACCESS_TOKEN=
CASEOPS_WHATSAPP_PHONE_NUMBER_ID=
CASEOPS_WHATSAPP_TEMPLATE_NAME=

# Inbound email aliases. Production mode requires a real provider with HMAC
# signature verification and DNS/security proof. Disabled mode rejects inbound
# email and is the safe default.
CASEOPS_INBOUND_EMAIL_PROVIDER_MODE=disabled
CASEOPS_INBOUND_EMAIL_DOMAIN=inbound.disabled.caseops.local
CASEOPS_INBOUND_EMAIL_WEBHOOK_SECRET=
CASEOPS_INBOUND_EMAIL_SIGNATURE_HEADER=x-caseops-inbound-signature
