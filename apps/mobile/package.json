{
  "name": "@caseops/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test src/network/*.test.ts src/auth/*.test.ts src/domain/*.test.ts",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@expo/ui": "58.0.23",
    "@expo/vector-icons": "15.0.2",
    "expo": "58.0.19",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.15",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.11",
    "expo-linking": "58.0.14",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/node": "26.6.5",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  },
  "overrides": { "zod": "$zod" }
}
